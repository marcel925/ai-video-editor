# Copy to .env and fill in. Only /edit_video_plus needs these (stock b-roll).
# Free keys: https://www.pexels.com/api/  and  https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Motion-graphics engine for the edited version: remotion or hyperframes.
# Unset = whichever tools/setup.sh installed (Remotion if both). Remotion is
# free for individuals and companies of up to 3 people; HyperFrames is
# Apache-2.0. Install the other with: tools/setup.sh --motion hyperframes
MOTION_ENGINE=
