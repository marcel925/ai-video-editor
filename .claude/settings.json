{
  "autoMemoryEnabled": false,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/device-mute-on-boot.mts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
